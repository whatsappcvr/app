# Base URL of the backend's mobile API (FastAPI app/parent_app), including /api/v1.
# Production backend: https://communicator.cvr.ac.in/api/v1
# - iOS simulator / same-machine web:  http://localhost:8000/api/v1
# - Android emulator:                  http://10.0.2.2:8000/api/v1
# - Physical device (same Wi-Fi):      http://<your-machine-LAN-IP>:8000/api/v1
EXPO_PUBLIC_API_URL=https://communicator.cvr.ac.in/api/v1

# Set to "true" to force mock data even when EXPO_PUBLIC_API_URL is set.
# Leave unset/false to use the real backend above.
EXPO_PUBLIC_USE_MOCKS=false
